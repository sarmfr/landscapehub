APP_NAME=LandScapeHub
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.wasmer.app

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=your-db-host
DB_PORT=3306
# Leave DB_DATABASE blank when using a Wasmer-managed database capability.
# The app will fall back to Wasmer's DB_NAME secret automatically.
DB_DATABASE=
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password
MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=false

CACHE_DRIVER=database
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
FILESYSTEM_DISK=public
# Optional override if you mount the Wasmer volume somewhere else.
PUBLIC_DISK_ROOT=

PAYMENT_PROVIDER=mock
PAYMENT_COMMISSION_RATE=10

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_ENV=sandbox

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@landscapehub.com"
MAIL_FROM_NAME="${APP_NAME}"
